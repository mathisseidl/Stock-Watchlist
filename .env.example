# Market data provider (see lib/market-data/index.ts)
MARKET_DATA_PROVIDER=finnhub

# Get a free API key at https://finnhub.io/register
FINNHUB_API_KEY=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — use TEST/sandbox keys while developing
STRIPE_SECRET_KEY=

# Optional. With a key set, Claude writes the Pro news briefings; without one
# the built-in composer assembles them from the same articles.
ANTHROPIC_API_KEY=

# Base URL used for Stripe checkout redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
